# Copy to .env for local runs. .env is gitignored and must stay that way.
# In production these are GitHub Actions secrets, never files in the repo.

# --- Google ---------------------------------------------------------------
# The whole service-account JSON key on one line, or base64 of it.
# Share each calendar with the service account's client_email before running.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Calendar ids live in job/config/ministries.json, not here. They are not
# credentials: the calendars are not public, so reading one requires the
# service account to be shared onto it. These variables exist only to
# repoint a calendar in an emergency without a commit.
# CAL_CHURCH=
# CAL_YOUTH=
# CAL_YOUTH_LEADERS=

# --- Sheet ----------------------------------------------------------------
SHEET_ID=

# --- GroupMe --------------------------------------------------------------
# From dev.groupme.com/bots. The bot must be a member of the group.
# Point this at a private test group first.
GROUPME_BOT_YOUTH_PARENTS=

# --- Admin form -----------------------------------------------------------
ADMIN_PASSCODE=

# --- Behaviour ------------------------------------------------------------
# Log reminders instead of sending them. Also available as --dry-run.
DRY_RUN=true
# Run off job/fixtures/calendars.json with no Google calls. Also --fixtures.
FIXTURES=
