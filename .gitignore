node_modules/
.env
.env.local
*.local.json

# Service account keys must only ever live in GitHub Actions secrets.
*service-account*.json
*credentials*.json
*.pem

.DS_Store
Thumbs.db
*.log

# Personal token feeds are regenerated from the Sheet on every run, so they
# never need to be in git. Keeping them out means a public repo cannot expose
# one person's private-ministry events to anyone browsing the code. They are
# still written into public/f/ at run time and deployed with the site.
public/f/*.ics

# Deploy staging directory, assembled by the workflow.
_site/

# Raw calendar snapshots, including private ministries. Pushed to a separate
# private repository by the workflow, never to this public one.
backup/

# Output of a fixture run. Never published; keeps npm run dev from
# clobbering the real data in public/.
.dev-site/

# Combination feeds are rebuilt every run and there are hundreds of them.
# Committing them would churn the repo hourly for no gain: the site is
# deployed from the run output, not from the branch.
public/c/*.ics
